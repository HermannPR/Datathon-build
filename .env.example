# Configuración de desarrollo para Datathon

# Backend Flask
FLASK_ENV=development
FLASK_DEBUG=True
BACKEND_PORT=5000

# Frontend React
VITE_API_URL=http://localhost:5000
FRONTEND_PORT=5173

# Rutas de archivos
UPLOAD_FOLDER=uploads
MODEL_FOLDER=backend

# Configuración de modelos
REGRESSION_MODEL=modelo_regresion_ahorro_ganancia.h5
CLASSIFICATION_MODEL=modelo_clasificacion_emisora.h5
SCALER_FILE=scaler.pkl
LABEL_ENCODER_FILE=label_encoder.pkl

# Configuración de CORS (para desarrollo)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configuración de archivos CSV
MAX_FILE_SIZE=10MB
ALLOWED_EXTENSIONS=csv

# Configuración de predicción
REQUIRED_COLUMNS=montoCobrar,montoCobrado,montoExigible,diaCobro,horaCobro
